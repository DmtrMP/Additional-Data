		</region>
		<region region-id="56" left="120" top="2056.5" width="132" height="43.5" align-x="165" align-y="2082" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve" subscript="x2">E</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
							<ml:id xml:space="preserve">v</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:pow/>
								<ml:apply>
									<ml:id xml:space="preserve">cos</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
								<ml:real>4</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve" subscript="y2">E</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">φ</ml:id>
									<ml:id xml:space="preserve">v</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:id xml:space="preserve">k</ml:id>
								<ml:id xml:space="preserve">φ</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:apply>
									<ml:id xml:space="preserve">sin</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
								<ml:real>4</ml:real>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
