		<region region-id="55" left="6" top="2056.5" width="99" height="31.5" align-x="52.5" align-y="2076" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve" subscript="y2">E</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
							<ml:id xml:space="preserve">v</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve" subscript="1">E</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">k</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:id xml:space="preserve">v</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:id xml:space="preserve">k</ml:id>
								<ml:id xml:space="preserve">φ</ml:id>
							</ml:apply>
							<ml:real>1</ml:real>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
