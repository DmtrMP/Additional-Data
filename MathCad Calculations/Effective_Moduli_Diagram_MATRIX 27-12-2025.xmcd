		<region region-id="1631" left="18" top="1015.5" width="506.25" height="87.75" align-x="75.75" align-y="1062" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve" subscript="n">S</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
							<ml:id xml:space="preserve">v</ml:id>
							<ml:id xml:space="preserve">ψ0</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:id xml:space="preserve">ψ90</ml:id>
										<ml:sequence>
